# ==============================================================================
# SentinelNet Platform Environment Variables
# Copy to .env and configure for your deployment environment (Local or Production)
# ==============================================================================

# Server configuration
PORT=4000
APP_URL=http://localhost:4000

# Authentication (JWT) — MUST be changed for non-local production deployment
JWT_SECRET=dev-only-change-me-in-production-random-secure-secret
JWT_EXPIRES_IN=8h

# Database Persistence (Supabase / PostgreSQL)
# When provided, SentinelNet connects to PostgreSQL and applies schema.sql
# When omitted, local dev falls back to local JSON file db.json automatically
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Optional Supabase credentials for client / storage integrations
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Groq AI Integration (Server-side only — never exposed to client)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_ENABLED=true

# Local JSON fallback file path
DB_FILE=./server/src/data/db.json
